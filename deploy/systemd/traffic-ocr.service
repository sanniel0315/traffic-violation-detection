[Unit]
Description=Traffic OCR Microservice (YOLO Character Detection)
After=network.target
Before=traffic-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/traffic-violation-detection
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/home/ubuntu/.local/lib/python3.10/site-packages/nvidia/cusparselt/lib
ExecStart=/usr/bin/python3 services/ocr_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
