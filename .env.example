# 時區
TZ=Asia/Taipei

# Frigate
FRIGATE_HOST=127.0.0.1
FRIGATE_RTSP_PASSWORD=

# Model paths
# MODEL_DIR 預設模型目錄；DETECT_MODEL_* 可填絕對路徑或檔名/相對路徑
# 新板第一次只有 .pt 時，ENGINE 留空會 fallback 用 .pt（較慢），build engine 後再填回。
MODEL_DIR=models
DETECT_MODEL_ENGINE=yolov8n.engine
DETECT_MODEL_PT=yolov8n.pt

# 對外報表 API 固定金鑰（外部系統呼叫 /api/external/*）。換站請改成新的隨機值。
EXTERNAL_API_KEY=changeme-generate-a-random-key

# IO daemon（RS-485 獨立 process）位址；通常不用改
IO_DAEMON_URL=http://127.0.0.1:8011

# 資料庫 (可選)
# DATABASE_URL=postgresql://user:pass@localhost:5432/traffic

# MQTT (可選)
# MQTT_HOST=localhost
# MQTT_PORT=1883

# TDX(交通部運輸資料流通服務)eTag 站間旅行時間 —— 成效報告的「平均旅行時間(主線實測)」
# 到 https://tdx.transportdata.tw 申請會員金鑰。沒填就不抓,系統其他部分照常。
# TDX_CLIENT_ID=
# TDX_CLIENT_SECRET=
# TDX_ROAD_ID=000080            # 國道 8 號
# TDX_ETAG_PAIRS=               # 用 /api/signal/shadow/tdx/discover?km=<交流道里程> 挑,逗號分隔
# TDX_FETCH_SEC=300
